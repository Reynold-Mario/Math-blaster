{
	"name": "pixel-blaster",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"workspaces": [
		"apps/*",
		"games/*",
		"packages/*"
	],
	"scripts": {
		"dev": "concurrently --kill-others --prefix-colors auto \"npm:dev:*\"",
		"dev:catalog": "npm run dev --workspace apps/web",
		"dev:math-blaster": "npm run dev --workspace games/math-blaster",
		"lint": "prettier --check --cache . && eslint --cache --cache-strategy content .",
		"format": "prettier --write .",
		"build": "npm run build --workspaces --if-present",
		"check": "npm run check --workspaces --if-present",
		"test": "npm run test --workspaces --if-present"
	},
	"engines": {
		"node": ">=22"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"concurrently": "^10.0.7",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"typescript-eslint": "^8.72.2"
	}
}
