.idea
.DS_Store

# Secrets. No env file is ever committed; `.env.example` documents the shape
# instead. `.env.local` at this level is where ROADMAP.md puts the Supabase test
# credentials, and until this rule existed it was untracked but NOT ignored -
# one `git add -A` away from being committed.
.env
.env.*
!.env.example

# Build output and dependencies. There is one ignore file now, at the root:
# the workspaces used to carry their own, which meant a new workspace was
# uncovered until it remembered to add one. No leading slash, so these match
# at any depth - root, `apps/*`, `games/*` and `packages/*` alike.
node_modules/
dist/
dist-ssr/
.netlify/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editor and OS cruft, merged in from the game's own ignore file.
.vscode/*
!.vscode/extensions.json
*.local
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Per-user agent state. `.claude/` itself is not ignored - project-level agent
# config belongs in review.
.claude/settings.local.json
.claude/worktrees/

# ESLint cache. Prettier's lives under node_modules/.cache, already ignored.
.eslintcache
